# Gemini
GEMINI_API_KEY=replace_me
GEMINI_MODEL=gemini-2.5-flash

# Browser-visible API URL.
# Local Docker: http://localhost:8000
# Production behind a domain: https://api.example.com
PRISM_BROWSER_API_URL=http://localhost:8000

# Optional proxy configuration for real deployments.
TRUST_PROXY_HEADERS=false
